{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (port 5100)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Debug",
            "program": "${workspaceFolder}/backend/api/bin/Debug/net10.0/MeterVision.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/api",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5100"
            }
        },
        {
            "name": "Release (port 5100)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Release",
            "program": "${workspaceFolder}/backend/api/bin/Release/net10.0/MeterVision.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/api",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Production",
                "ASPNETCORE_URLS": "http://localhost:5100"
            }
        }
    ]
}